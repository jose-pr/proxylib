# Nothing dot-prefixed at the repository root is tracked except these.
/.*
!/.gitignore
!/.gitattributes
!/.github/

# Private agent config and personal overrides.
.agents
*.local.*
CLAUDE*
.claude

# Local scratch names
/_*
[a-zA-Z]*__
[a-zA-Z]*__.*

# Build and docs output
/dist
/build
/site

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
